def sign_when_done(ctx: Ctx):
    """The advance yes, if it is for this exact statement text (a reworded statement needs a new yes)."""
    w = ctx.conf().get("sign_when_done") or {}
    return w if w.get("statement_sha256") == hashlib.sha256(statement_text().encode()).hexdigest() else None


def set_sign_when_done(ctx: Ctx):
    ctx.set_conf(sign_when_done={"agreed": iso(time.time()),
                                 "statement_sha256": hashlib.sha256(statement_text().encode()).hexdigest()})
    print("Signed in advance: when your export matches the reference, your records carry the signature and the "
          "leaderboard lists it. Nothing is signed before then. Undo any time: riemann-at-home sign --cancel")


def agree(ctx: Ctx, name=None, upstream=None):
    if name:
        err = name_problem(name)
        if err:
            raise Fail(f"display name {err}")
    check_gh(True)
    login = gh_login()
    print(consent_notice(login) + "\n")
    ctx.set_conf(consent={"agreed": iso(time.time()), "login": login})
    if name:
        ctx.set_conf(display={"display_name": name})
    sc = ctx.conf().get("submit") or {}
    ctx.set_conf(submit={**sc, "auto": True, "upstream": upstream or sc.get("upstream") or UPSTREAM})
    print(f"Agreed. Progress is posted from GitHub account {login} about every {autosubmit_interval(ctx) / 60:g} "
          "minutes while you build" + (f", shown as \"{name}\" on the leaderboard (GitHub shows {login} on the "
                                       "commits and pull request)." if name else f", shown as {login}."))
    ensure_companion(ctx)


def cmd_submit(ctx: Ctx, a):
    # every proof submits the same way (one PR per build); a 300K record says "proof": "300k" (CONTRACT "Several proofs")
    if getattr(a, "agree", False):
        agree(ctx, a.name, a.upstream)
        if ctx.p["levels"]:
            ask_sign_when_done(ctx)                 # the optional second question, as at setup (17M only)
        share_nudge(ctx, "joined")
        return 0
    if a.interval is not None:
        if a.interval < MIN_INTERVAL:
            raise Fail(f"--interval must be at least {MIN_INTERVAL} seconds")
        sc = ctx.conf().get("submit") or {}
        ctx.set_conf(submit={**sc, "interval": int(a.interval)})
        print(f"auto-submit interval: {int(a.interval)} s (a running build uses it from its next cycle)")
        if not (a.enable_auto or a.disable_auto):
            if sc.get("auto"):
                ensure_companion(ctx)
            return 0
    if a.enable_auto or a.disable_auto:
        sc = ctx.conf().get("submit") or {}
        if a.enable_auto:
            need_consent(ctx)
            check_gh(True)
            ctx.set_conf(submit={**sc, "auto": True, "upstream": a.upstream or sc.get("upstream") or UPSTREAM})
            print(f"auto-submit on: a running build updates its pull request on {a.upstream or sc.get('upstream') or UPSTREAM} "
                  f"every {autosubmit_interval(ctx):g} s (no restart needed). Turn off: riemann-at-home submit --disable-auto")
            ensure_companion(ctx)
        else:
            ctx.set_conf(submit={**sc, "auto": False})
            print("auto-submit off")
        return 0
    if a.repo and not a.dry_run:
        raise Fail(f"--repo is only for --dry-run; real submits use the tool's own clone at {ctx.base / 'repo'}")
    src = Path(a.record) if a.record else latest_record(ctx)
    rec = json.loads(src.read_text())
    errs = validate_record(rec)
    if errs:
        raise Fail(f"{src} is not a valid {FORMAT} record:\n  " + "\n  ".join(errs))
    if not a.no_gh_check:
        check_gh(a.dry_run)
    login = a.login or gh_login()
    if not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})", login):
        raise Fail(f"{login!r} does not look like a GitHub login")
    repo = Path(a.repo).expanduser().resolve() if a.repo else ctx.base / "repo"
    upstream = a.upstream or (ctx.conf().get("submit") or {}).get("upstream")
    if not upstream and a.repo:
        url = subprocess.run(["git", "-C", str(repo), "remote", "get-url", "origin"], capture_output=True,
                             text=True).stdout.strip()
        m = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?$", url)
        upstream = m[1] if m else None
    upstream = upstream or UPSTREAM
    if not a.dry_run:
        need_consent(ctx)
        with submit_lock(ctx):
            return submit_real(ctx, a, src, rec, login, upstream)
    bid = rec["build_id"]
    rel = f"submissions/{login}/{bid}.json"      # one file per build, overwritten on each update
    pr = pr_state(ctx, repo, upstream, rel, bid, check_github=not a.no_gh_check)
    if pr["done"]:
        raise Fail(f"build {bid} is finished ({pr['done']}); nothing more is submitted for it. "
                   "A new build on another computer gets its own build_id from `riemann-at-home setup`.")
    branch = f"rah/{bid}"                         # one branch and one PR for the build's whole life
    g = ["git", "-C", str(repo)]
    plan = ([] if (repo / ".git").exists() else [["gh", "repo", "clone", upstream, str(repo)]]) + [
        g + ["fetch", "origin", "main"], ["gh", "api", f"repos/{upstream}", "--jq", ".permissions.push"],
        ["# if that is not true:", "gh", "repo", "fork", "--remote", "--remote-name", "fork"],
        g + ["checkout", "-B", branch, "origin/main"], ["cp", str(src), str(repo / rel)], g + ["add", rel],
        g + ["commit", "-m", f"update: {rec['modules_compiled']} modules"],
        g + ["push", "--force", "origin (or fork)", f"HEAD:refs/heads/{branch}"]]
    if pr["state"] == "open":
        head = "update the open PR (quiet: no new PR)"
    else:
        lab = PROOFS[rec.get("proof", DEFAULT_PROOF)]["label"]
        plan.append(["gh", "pr", "create", "--repo", upstream, "--head", f"<{upstream.split('/')[0]} or {login}>:{branch}",
                     "--base", "main", "--title", f"Riemann@home {'' if lab == '17M' else lab + ' '}build {bid} ({login})",
                     "--body", "..."])
        head = "open this build's one PR"
    print(f"DRY RUN: nothing is written, committed, pushed or opened.\nrecord: {src}\nas:     {rel} on branch {branch}\n"
          f"step:   {head} -> {upstream}\nwould run:")
    for c in plan:
        print("  " + shlex.join(c))
    return 0


def autosubmit_interval(ctx: Ctx) -> float:
    """Seconds between auto-submits: `submit --interval` (config.json), else 600 (or RAH_AUTOSUBMIT_SECONDS)."""
    v = (ctx.conf().get("submit") or {}).get("interval")
    return max(MIN_INTERVAL, float(v)) if isinstance(v, (int, float)) else AUTOSUBMIT_SECONDS


def old_supervisor(ctx: Ctx):
    """pid of a running supervisor started before this version (fixed 10-minute cycle, calls `record`), else None."""
    sup = supervisor(ctx)
    if not sup:
        return None
    return None if read(ctx.logs / "supervisor.features").split()[:1] == [str(sup)] else sup


def ensure_companion(ctx: Ctx):
    """For a build whose supervisor predates the configurable interval: a small background loop that runs
    `_autosubmit` at the configured interval while that build runs and auto-submit is on. The build itself is not
    touched or restarted."""
    sup = old_supervisor(ctx)
    pidf = ctx.logs / "autosubmit-loop.pid"
    pid = read_pid(pidf)
    if not sup or (pid and pid_alive(pid, "_autosubmit_loop")):
        return
    with open(ctx.logs / "autosubmit.log", "ab") as lf:
        p = subprocess.Popen(ctx.me() + ["_autosubmit_loop", "--folder", str(ctx.folder), "--logs", str(ctx.logs)]
                             + ctx.pargs(), stdin=subprocess.DEVNULL, stdout=lf, stderr=lf, start_new_session=True,
                             env=ctx.env())
    pidf.write_text(str(p.pid))


def cmd_autosubmit_loop(ctx: Ctx, a):
    """The companion loop (see ensure_companion). Ends when the build stops or auto-submit is turned off."""
    sup = old_supervisor(ctx)
    me = ctx.me() + ["_autosubmit", "--folder", str(ctx.folder), "--logs", str(ctx.logs)] + ctx.pargs()
    while sup and supervisor(ctx) == sup and (ctx.conf().get("submit") or {}).get("auto"):
        time.sleep(autosubmit_interval(ctx))
        if supervisor(ctx) != sup or not (ctx.conf().get("submit") or {}).get("auto"):
            break
        with open(ctx.logs / "autosubmit.log", "a") as f:
            f.write(f"--- autosubmit (progress, every {autosubmit_interval(ctx):g} s) {iso(time.time())}\n")
            f.flush()
            try:
                subprocess.run(me, stdout=f, stderr=subprocess.STDOUT, env=ctx.env(), timeout=6 * 3600)
            except Exception as e:
                f.write(f"autosubmit failed: {e}\n")
    (ctx.logs / "autosubmit-loop.pid").unlink(missing_ok=True)
    return 0


def cmd_autosubmit(ctx: Ctx, a):
    """What the build supervisor runs about every 10 minutes: write a record, then, if auto-submit is on, update
    this build's PR. Rereads config.json each time. Never fails the build: errors are printed (to the log)."""
    try:
        if a.cmd != "record":                     # (an older supervisor calls `record`, which already wrote one)
            rec = make_record(ctx, a)
            out = write_record(ctx, rec)
            print(f"{rec['modules_compiled']:,} / {ctx.p['n']:,} {'' if ctx.proof == DEFAULT_PROOF else ctx.p['label'] + ' '}modules\n{out}")
        sc = ctx.conf().get("submit") or {}
        if sc.get("auto"):
            ns = argparse.Namespace(enable_auto=False, disable_auto=False, interval=None, repo=None, record=None, login=None,
                                    upstream=sc.get("upstream") or UPSTREAM, dry_run=False, no_gh_check=False)
            cmd_submit(ctx, ns)
            submit_status(ctx, None)
        elif ctx.conf().get("repo"):              # older setting: dry run into a given clone
            ns = argparse.Namespace(enable_auto=False, disable_auto=False, interval=None, repo=ctx.conf()["repo"], record=None,
                                    login=None, upstream=None, dry_run=True, no_gh_check=False)
            cmd_submit(ctx, ns)
        else:
            print("auto-submit is off (turn on: riemann-at-home submit --enable-auto)")
    except Fail as e:
        print(f"auto-submit: {e} (the build goes on; next try in about 10 minutes)")
        submit_status(ctx, str(e))
    except Exception as e:                        # network, git, anything: log it, keep building
        print(f"auto-submit failed: {type(e).__name__}: {e} (the build goes on)")
        submit_status(ctx, f"{type(e).__name__}: {e}")
    return 0


def submit_status(ctx: Ctx, error):
    """Remember how the last automatic update went, so `status` can say when they've been failing (before
    2026-11-22 a failing update was only visible in logs/autosubmit.log)."""
    p = ctx.home / "submit-status.json"
    try:
        old = json.loads(p.read_text())
    except (OSError, ValueError):
        old = {}
    now = iso(time.time())
    new = {"last_try": now, "last_ok": now if error is None else old.get("last_ok"), "error": error,
           "failing_since": None if error is None else (old.get("failing_since") or now)}
    try:
        p.write_text(json.dumps(new, indent=1) + "\n")
    except OSError:
        pass


def called_by_supervisor(ctx: Ctx) -> bool:
    sup = supervisor(ctx)
    return bool(sup) and os.getppid() == sup



# ---------------------------------------------------------------- levels: export, recheck, joint statement

def levels_state(ctx: Ctx, digest: str = None) -> dict:
    """Export / checker / signature results kept in config.json, tied to this build_id and to the olean digest
    of the whole build they were made from (a different folder state does not inherit them)."""
    lv = ctx.conf().get("levels") or {}
    if lv.get("build_id") != ctx.build_id(create=False) or (digest and lv.get("olean_digest") != digest):
        return {}
    return lv


def level_fields(ctx: Ctx, rec: dict) -> dict:
    """The optional record fields earned so far. Only a reproduced export goes into a record (the bot rejects any
    other export hash); checkers and the signature only on top of that."""
    if not rec.get("whole_proof") or not ctx.p["levels"]:
        return {}
    out = {}
    ep = export_progress(ctx, rec["olean_digest"])
    if ep:
        out["export_progress"] = ep
    lv = levels_state(ctx, rec["olean_digest"])
    ex = lv.get("export") or {}
    if ex.get("sha256") != EXPORT_SHA256:
        return out
    out.update({"export_sha256": ex["sha256"], "export_bytes": ex["bytes"]})
    if lv.get("checkers"):
        out["checkers"] = lv["checkers"]
    if lv.get("sign_statement") is True:
        out["sign_statement"] = True
    return out


def whole_build(ctx: Ctx, a, what: str) -> dict:
    """A record of the build, which must be whole with the axiom check passed."""
    rec = make_record(ctx, a)
    if not rec["whole_proof"]:
        raise Fail(f"{what} needs the whole build first: {rec['modules_compiled']:,} / {ctx.p['n']:,} modules compiled "
                   "and the axiom check run (`riemann-at-home build` runs it when the build finishes)")
    if sorted(rec["axioms"]) != sorted(EXPECTED_AXIOMS):
        raise Fail(f"{what} needs a passing axiom check; riemannHypothesis depends on {rec['axioms']}, "
                   f"expected {EXPECTED_AXIOMS}")
    return rec


FAST_EXIT_LOOP = ("    for c in constants do\n      modify (fun st => { st with noMDataExprs := {} })\n"
                  "      dumpConstant c\n")
FAST_EXIT_ADD = "    (← IO.getStdout).flush\n    IO.Process.exit 0\n"


def patch_fast_exit(main_lean: str):
    """lean4export's Main.lean with Derek Blanchette's fix (issue #24), or None if the file is not the one it fits.
    After the last constant the exporter used to free its whole cache one object at a time before exiting; on a
    computer that is swapping that took hours at "99%" with all the data already written. The fix flushes the
    output and exits, and the operating system frees the memory at once. The output is unchanged; the export's own
    comparison with the reference hash checks that on every run."""
    body = main_lean.rstrip("\n") + "\n"
    if not body.endswith(FAST_EXIT_LOOP) or body.count(FAST_EXIT_LOOP) != 1:
        return None
    return body + FAST_EXIT_ADD


def exporter_command(ctx: Ctx, a) -> list:
    """`lake env <lean4export> Main`, run in the build folder. lean4export is built once from the pinned tag into
    ~/.riemann-at-home/tools, with the PROOF's toolchain (TOOLCHAIN), not the one the tag pins: Lean only reads
    .olean files written by the same Lean version, so an exporter built with v4.33.0 fails on this v4.33.1 build
    with "incompatible header" (reported 2026-11-22, issue #14). The folder name carries the toolchain, so an
    exporter built the old way is never reused."""
    if getattr(a, "exporter", None):                         # testing: a stand-in exporter
        return [a.exporter, "Main", "--", *EXPORT_TARGETS]
    fast = bool(getattr(a, "fast_exit", False))
    src = ctx.home / "tools" / (f"lean4export-{EXPORTER_TAG}-lean-{TOOLCHAIN.rsplit(':', 1)[-1]}"
                                + ("-fastexit" if fast else ""))   # never mixed up with the unpatched build
    exe = src / ".lake/build/bin/lean4export"
    if not exe.exists():
        if not src.exists():
            src.parent.mkdir(parents=True, exist_ok=True)
            tmp = src.with_name(src.name + f".cloning-{os.getpid()}")
            if run(["git", "clone", "-q", "--depth", "1", "--branch", EXPORTER_TAG, EXPORTER_REPO, tmp]).returncode != 0:
                shutil.rmtree(tmp, ignore_errors=True)
                raise Fail(f"could not download lean4export {EXPORTER_TAG} from {EXPORTER_REPO}")
            (tmp / "lean-toolchain").write_text(TOOLCHAIN + "\n")    # build with the proof's Lean (see above)
            if fast:
                patched = patch_fast_exit((tmp / "Main.lean").read_text())
                if patched is None:
                    shutil.rmtree(tmp, ignore_errors=True)
                    raise Fail(f"lean4export {EXPORTER_TAG}'s Main.lean is not the one --fast-exit fits; "
                               "run export without --fast-exit")
                (tmp / "Main.lean").write_text(patched)
            tmp.rename(src)
        tc = toolchain_of(src)
        if tc != TOOLCHAIN:
            raise Fail(f"{src} pins {tc or 'no toolchain'}, expected {TOOLCHAIN}; delete that folder and run export again")
        elan = ensure_elan()
        if not toolchain_installed(elan, tc):
            print(f"installing {tc} (the proof's toolchain, to build lean4export {EXPORTER_TAG})")
            if run([elan, "toolchain", "install", tc], env=lean_env()).returncode != 0:
                raise Fail(f"could not install {tc}")
        print(f"building lean4export {EXPORTER_TAG} with {tc}")
        if run([which("lake") or "lake", "build"], cwd=src, env=lean_env()).returncode != 0 or not exe.exists():
            raise Fail(f"building lean4export failed (in {src})")
    return [which("lake") or "lake", "env", str(exe), "Main", "--", *EXPORT_TARGETS]


EXPORT_CHECK_AFTER = 300        # seconds into a build before the export check runs (some modules are compiled by then)


def export_check(ctx: Ctx, a=None) -> dict:
    """Catch export problems in minutes, not after an 18-hour build (issue #14): build lean4export exactly as
    `export` does, export ONE already-compiled module (the smallest), and check that its first line says it read
    this build's Lean version. Nothing is kept but the result, saved to export-check.json and returned."""
    res = {"checked": iso(time.time()), "ok": False}
    try:
        done = compiled_modules(ctx.lib)
        if not done:
            res["error"] = "no compiled module yet to test the exporter on"
            return res
        mod = min(done, key=lambda m: ((ctx.lib / (m.replace(".", "/") + ".olean")).stat().st_size, m))
        full = exporter_command(ctx, a or argparse.Namespace(exporter=None))
        cmd = full[:full.index("Main")] + [mod]         # just one module, all of it
        res.update(module=mod, exporter=Path(cmd[-2]).parents[3].name if len(cmd) > 2 else Path(cmd[0]).name)
        with tempfile.TemporaryFile() as err:
            p = subprocess.Popen(["nice", "-n", "19"] + list(map(str, cmd)), cwd=ctx.folder, stdin=subprocess.DEVNULL,
                                 stdout=subprocess.PIPE, stderr=err, env=lean_env())
            try:
                first = p.stdout.readline(1 << 20)
            finally:
                p.kill(); p.stdout.close(); p.wait()
            err.seek(0); msg = err.read().decode(errors="replace").strip()
        want = TOOLCHAIN.rsplit(":v", 1)[-1]
        try:
            got = json.loads(first)["meta"]["lean"]["version"]
        except (ValueError, KeyError, TypeError):
            got = None
        res["lean_version"] = got
        if got == want:
            res["ok"] = True
        else:
            res["error"] = (msg.splitlines()[-1][:300] if msg else
                            f"the exporter wrote no export header (Lean {got or '?'}, expected {want})")
    except Fail as e:
        res["error"] = str(e)[:300]
    except Exception as e:
        res["error"] = f"{type(e).__name__}: {e}"[:300]
    try:
        (ctx.home / "export-check.json").write_text(json.dumps(res, indent=1) + "\n")
    except OSError:
        pass
    return res


def export_check_state(ctx: Ctx) -> dict:
    try:
        return json.loads((ctx.home / "export-check.json").read_text())
    except (OSError, ValueError):
        return {}


def setup_export_check(ctx: Ctx, stop: "threading.Event"):
    """Background thread: EXPORT_CHECK_AFTER seconds into the build, run export_check once (again only if the last
    result failed or used a different exporter). Never touches the build; a failure is logged and shown in status."""
    def go():
        if stop.wait(EXPORT_CHECK_AFTER):
            return
        last = export_check_state(ctx)
        want = f"lean4export-{EXPORTER_TAG}-lean-{TOOLCHAIN.rsplit(':', 1)[-1]}"
        if last.get("ok") and last.get("exporter") == want:
            return
        r = export_check(ctx)
        log_event(ctx, "EXPORT_CHECK=" + ("ok" if r["ok"] else "failed"))
        print(f"export check: {'ok, the export step will work on this computer' if r['ok'] else 'FAILED: ' + r.get('error', '?')}"
              + ("" if r["ok"] else ". The build goes on, but the export at the end would fail: please report this at "
                 "https://github.com/riemann-at-home/riemann-at-home/issues"), flush=True)
    threading.Thread(target=go, daemon=True).start()


def export_progress(ctx: Ctx, digest: str):
    """The record's export_progress for this build and olean digest: progress while `export` runs, the result once
    done. An unfinished export not updated for EXPORT_STALE seconds (stopped, crashed) is left out."""
    try:
        p = json.loads((ctx.home / "export-progress.json").read_text())
    except (OSError, ValueError):
        return None
    if p.get("build_id") != ctx.build_id(create=False) or p.get("olean_digest") != digest:
        return None
    if not p.get("done") and time.time() - p.get("updated", 0) > EXPORT_STALE:
        return None
    return {k: p.get(k) for k in EXPORT_PROGRESS_FIELDS}


def tree_memory_gb(root: int) -> float:
    """Resident memory of a process and all its descendants, in GB (the exporter runs under nice and lake env)."""
    try:
        out = subprocess.run(["ps", "-A", "-o", "pid=,ppid=,rss="], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return 0.0
    kids, rss = {}, {}
    for line in out.splitlines():
        f = line.split()
        if len(f) == 3 and all(x.isdigit() for x in f):
            kids.setdefault(int(f[1]), []).append(int(f[0])); rss[int(f[0])] = int(f[2])
    total, todo = 0, [root]
    while todo:
        p = todo.pop(); total += rss.get(p, 0); todo += kids.get(p, [])
    return total / 2 ** 20                                   # ps reports KiB


def fmt_dur(t: float) -> str:
    m = max(1, round(int(t) / 60))                # whole minutes first, so 7170 s is "2 h 0 m", never "1 h 60 m"
    return f"{m} m" if m < 60 else f"{m // 60} h {m % 60} m"


EXPORT_QUIET_SECONDS = 60     # no output for this long: say so instead of a frozen "about 1 m left"
EXPORT_ETA_AFTER = 60         # seconds of output before the first "about N left" (too early, the speed is noise)


def export_left(n: int, total: int, out_seconds: float):
    """Seconds left, from the speed since the exporter's FIRST output: it first loads the proof for a while and says
    nothing, and counting that silence made the estimate huge at the start (a volunteer, issue #9)."""
    return (total - n) / (n / out_seconds) if n and out_seconds >= EXPORT_ETA_AFTER and n < total else None


def stream_export(ctx: Ctx, cmd: list, log: Path, sink=None, on_progress=None) -> tuple:
    """Run the exporter in the build folder at nice 19 and read its stdout straight into sha256 and a byte counter
    (and into `sink`, recheck's saved export file, if given). Without a sink nothing is written to disk. -> (exit code, sha256, bytes).
    A reader thread takes whatever output is there (not whole 1 MB pieces), and the progress line, the progress file
    and the leaderboard updates keep ticking every second even while the exporter is silent (a volunteer, 2026-11-23:
    the screen froze at 99.996% because the last 2.4 MB could not show until the exporter exited)."""
    import queue
    h, n = hashlib.sha256(), 0
    print("  $ " + shlex.join(map(str, cmd)) + f"   (in {ctx.folder}; output hashed"
          + (", saved for the checkers)" if sink is not None else ", not stored)"), file=sys.stderr)
    with open(log, "ab") as lf:
        p = subprocess.Popen(["nice", "-n", "19"] + list(map(str, cmd)), cwd=ctx.folder, stdin=subprocess.DEVNULL,
                             stdout=subprocess.PIPE, stderr=lf, env=lean_env())
    t0 = time.time()
    st = {"peak": 0.0, "next_mem": 0.0, "next_print": 0.0, "pct": -1, "last_out": t0, "quiet_said": 0, "first_out": None}
    tty = sys.stderr.isatty()
    q = queue.Queue(maxsize=64)

    def reader():
        try:
            while chunk := p.stdout.read1(1 << 20):
                q.put(chunk)
        except (OSError, ValueError):                         # pipe closed after the checker stopped reading
            pass
        finally:
            q.put(None)

    def show(final=False):
        now = time.time()
        el, quiet = now - t0, now - st["last_out"]
        out_el = now - st["first_out"] if st["first_out"] else 0.0   # time since the exporter started writing
        silent = not final and quiet >= EXPORT_QUIET_SECONDS
        left = export_left(n, EXPORT_BYTES, out_el) if not silent else None
        pct = min(100, int(n * 100 / EXPORT_BYTES))
        if on_progress:
            on_progress(n, el, left, st["peak"], final)
        if not tty and not final:                         # logs: one line per percent, one per quiet minute
            qm = int(quiet // EXPORT_QUIET_SECONDS) if silent else 0
            if pct == st["pct"] and qm <= st["quiet_said"] and now < st["next_print"]:
                return
            st["quiet_said"] = qm
        st["pct"], st["next_print"] = pct, now + 1800
        bar = "█" * (pct * 22 // 100) + "░" * (22 - pct * 22 // 100)
        line = (f"  EXPORTING {pct}%  {bar}  {n / 1e9:,.1f} of {EXPORT_BYTES / 1e9:,.1f} GB · {n / 1e6 / max(out_el, 1):,.1f} MB/s"
                + (f" · about {fmt_dur(left)} left" if left else "")
                + (f" · no output for {fmt_dur(quiet)}, the exporter is still running" if silent else "")
                + (f" · memory {st['peak']:,.0f} GB" if st["peak"] else ""))
        print(("\r" + line.ljust(130)) if tty else line, end="" if tty and not final else "\n", file=sys.stderr, flush=True)

    threading.Thread(target=reader, daemon=True).start()
    next_show = 0.0
    try:
        while True:
            try:
                chunk = q.get(timeout=1)
            except queue.Empty:
                chunk = b""
            if chunk is None:
                break
            now = time.time()
            if chunk:
                st["last_out"] = now
                st["first_out"] = st["first_out"] or now
                h.update(chunk)
                n += len(chunk)
                if sink is not None:
                    sink.write(chunk)
            if now >= st["next_mem"]:                         # peak memory of the exporter (and lake env) every 5 s
                st["peak"], st["next_mem"] = max(st["peak"], tree_memory_gb(p.pid)), now + 5
            if now >= next_show:
                show(); next_show = now + 1
    except BaseException:                                     # a full disk, Ctrl-C, ...: stop the exporter, or
        p.kill()                                              # it blocks on a full pipe and p.wait() never returns
        raise
    finally:
        rc = p.wait()
        p.stdout.close()
    show(final=True)
    return rc, h.hexdigest(), n


def cmd_export(ctx: Ctx, a):
    """Level 2: export the compiled proof with lean4export and compare it with the reference export."""
    if getattr(a, "check", False):                            # a minute: will the export work here? (issue #14)
        r = export_check(ctx, a)
        if r["ok"]:
            print(f"export check ok: {r['exporter']} read {r['module']} (Lean {r['lean_version']})")
            return 0
        print(f"export check FAILED: {r.get('error')}", file=sys.stderr)
        return 1
    st = ctx.conf().get("pr") or {}
    rec = whole_build(ctx, a, "export")
    if st.get("build_id") == rec["build_id"] and st.get("final_sent"):
        raise Fail("this build's final record was already sent, so an export result can't reach the leaderboard any "
                   "more (the bot takes no updates after `finish`)")
    keep_awake()
    cmd = exporter_command(ctx, a)
    ctx.logs.mkdir(parents=True, exist_ok=True)
    log = ctx.logs / "export.log"
    print(f"exporting the proof: {EXPORT_BYTES / 1e9:.1f} GB of output, hashed as it streams (nothing written to disk)")
    warn = export_memory_warning(total_ram_gb())
    if warn:
        print(warn, file=sys.stderr)
    t0 = time.time()
    pf = ctx.home / "export-progress.json"
    base = {"build_id": rec["build_id"], "olean_digest": rec["olean_digest"]}
    auto = AUTOSUBMIT != "off" and bool((ctx.conf().get("submit") or {}).get("auto"))
    sent = {"at": time.time()}

    def progress(n, el, left, peak, final):
        pf.write_text(json.dumps({**base, "bytes": n, "seconds": int(el), "left_seconds": None if final or left is None
                                  else int(left), "peak_memory_gb": round(peak, 2) if peak else None, "done": False,
                                  "updated": int(time.time())}) + "\n")
        if auto and not final and time.time() - sent["at"] >= autosubmit_interval(ctx):   # the leaderboard's gold bar
            sent["at"] = time.time()
            threading.Thread(target=autosubmit, args=(ctx, a, "export progress"), daemon=True).start()

    rc, sha, n = stream_export(ctx, cmd, log, on_progress=progress)
    if rc != 0:
        pf.unlink(missing_ok=True)
        raise Fail(f"the exporter exited with {rc}; see {log}")
    match = sha == EXPORT_SHA256 and n == EXPORT_BYTES
    last = json.loads(pf.read_text())
    pf.write_text(json.dumps({**last, "done": True, "left_seconds": None, "updated": int(time.time())}) + "\n")
    peak = f", peak memory {last['peak_memory_gb']:,.0f} GB" if last.get("peak_memory_gb") else ""
    lv = levels_state(ctx, rec["olean_digest"])
    advance = bool(sign_when_done(ctx)) and match
    same = (lv.get("export") or {}).get("sha256") == sha
    if not match and (lv.get("export") or {}).get("sha256") == EXPORT_SHA256:
        # an earlier export here matched: keep it (and Level 2, checkers, signature); this run is only reported
        print("this export did not match, but an earlier one on this build did: keeping that result (Level 2 stays)")
    else:
        ctx.set_conf(levels={"build_id": rec["build_id"], "olean_digest": rec["olean_digest"],
                             "export": {"sha256": sha, "bytes": n, "exporter": f"lean4export {EXPORTER_TAG}",
                                        "seconds": int(time.time() - t0), "when": iso(time.time())},
                             "checkers": lv.get("checkers", []) if same else [],
                             "sign_statement": (bool(lv.get("sign_statement")) and same or advance) and match})
    print(f"export sha256 {sha}\nexport bytes  {n:,}")
    if auto:
        autosubmit(ctx, a, "export done")                   # the leaderboard shows the result (and Level 2 if it matches)
    if not match:
        print(f"reference     {EXPORT_SHA256}, {EXPORT_BYTES:,} bytes (Andrew Sutherland, https://math.mit.edu/~drew/grh)")
        print("does not match the reference, so records do not carry it.")
        print(UNVERIFIED)
        return 1
    print(f"export matches the reference ✓  ({fmt_dur(time.time() - t0)}{peak})")
    if advance:
        print(f"Joint statement signed, as you chose at setup ({sign_when_done(ctx)['agreed'][:10]}). "
              "Undo: riemann-at-home sign --cancel")
    print("Level 2: matches the reference export (Andrew Sutherland, https://math.mit.edu/~drew/grh).")
    out = write_record(ctx, make_record(ctx, a))
    print(f"record with export_sha256: {out}")
    if advance:
        share_nudge(ctx, "signed")
    return 0


def total_ram_gb() -> float:
    if os.environ.get("RAH_TEST_RAM_GB"):                    # testing only
        return float(os.environ["RAH_TEST_RAM_GB"])
    if IS_MAC:
        r = subprocess.run(["sysctl", "-n", "hw.memsize"], capture_output=True, text=True).stdout.strip()
        return int(r) / 2 ** 30 if r.isdigit() else 0.0
    m = re.search(r"^MemTotal:\s+(\d+) kB", read(Path("/proc/meminfo")), re.M)
    return int(m[1]) / 2 ** 20 if m else 0.0


# Measured 2026-11-23 (a volunteer's 125 GiB Linux computer): lean4export holds ~70 GB of its own data and keeps rereading ~60 GB of
# compiled .olean files; at 99.996% its RAM and 8 GiB of swap were full, and the last 2.4 MB took 1 h 47 m (2 h 57 m in all).
EXPORT_RAM_COMFORTABLE_GB, EXPORT_RAM_MINIMUM_GB = 140, 96


def export_memory_warning(ram_gb: float):
    """A warning (or None) about this computer's memory for the export. Never refuses: it is the volunteer's call."""
    if not ram_gb or ram_gb >= EXPORT_RAM_COMFORTABLE_GB:
        return None
    need = ("the export holds about 70 GB of its own data and keeps rereading about 60 GB of compiled proof files, "
            f"so it is happiest with {EXPORT_RAM_COMFORTABLE_GB} GB or more")
    if ram_gb < EXPORT_RAM_MINIMUM_GB:
        return (f"warning: this computer has {ram_gb:.0f} GB of memory; {need}. With less than "
                f"{EXPORT_RAM_MINIMUM_GB} GB it will swap heavily and may never finish. Level 2 is optional.")
    tip = " Close other programs; more swap (32 GB or so) helps." if not IS_MAC else " Close other programs."
    return (f"warning: this computer has {ram_gb:.0f} GB of memory; {need}. It should work, but the last part may "
            f"slow down a lot as memory fills (on a 125 GB computer the final 0.01% took almost 2 hours).{tip}")


def saved_export_path(ctx: Ctx) -> Path:
    return ctx.home / "export" / f"proof-{EXPORT_SHA256[:16]}.ndjson"


def saved_export(ctx: Ctx, a) -> Path:
    """The reference export as a file, for the checkers. Neither checker reads it from a pipe the way we used to send
    it (con-leche takes FILE.ndjson, nanoda a config that names the file), and piping kept the exporter (~145 GB) and
    the checker in memory together, which hung nanoda even on 256 GB (a volunteer, issue #9). So: export once to
    disk, prove it is the reference, then run each checker alone. Kept, so the second checker reuses it."""
    path = saved_export_path(ctx)
    if path.exists():
        if path.stat().st_size == EXPORT_BYTES:
            print(f"using the saved export {path} (checking its sha256 first)")
            if sha256_file(path) == EXPORT_SHA256:
                return path
        print(f"the saved export {path} is not the reference export; making it again")
        path.unlink()
    path.parent.mkdir(parents=True, exist_ok=True)
    part = path.with_name(path.name + ".partial")
    part.unlink(missing_ok=True)                               # left by a run that was killed: it is our own space
    free = shutil.disk_usage(path.parent).free / 1e9
    need = EXPORT_BYTES / 1e9 + MIN_FREE_GB
    if free < need:
        raise Fail(f"recheck saves the export ({EXPORT_BYTES / 1e9:,.1f} GB) to {path.parent} first, and "
                   f"{free:,.0f} GB are free there (needs about {need:,.0f} GB). Free some disk and try again.")
    print(f"exporting once to {path} ({EXPORT_BYTES / 1e9:,.1f} GB on disk; the checkers then read it from there)")
    if warn := export_memory_warning(total_ram_gb()):
        print(warn, file=sys.stderr)
    try:
        with open(part, "wb") as f:
            rc, sha, n = stream_export(ctx, exporter_command(ctx, a), ctx.logs / "export.log", sink=f)
        if rc != 0 or sha != EXPORT_SHA256 or n != EXPORT_BYTES:
            raise Fail(f"the export was not the reference export (sha256 {sha}, {n:,} bytes, exporter exit {rc}); "
                       f"nothing recorded. See {ctx.logs / 'export.log'}")
        part.rename(path)
    finally:
        part.unlink(missing_ok=True)
    return path


def checker_command(name: str, exe: str, export: Path, extra: list, cpus: int) -> list:
    """How each checker is told where the export is (their READMEs, 2026-11-23): con-leche takes the file as its last
    argument; nanoda_bin takes only a JSON config file, which we write next to the export."""
    if name == "con-leche":
        return [exe, *extra, "--", str(export)]
    if extra:
        raise Fail("nanoda takes no command-line arguments, only its config file; drop --checker-args")
    cfg = export.with_name("nanoda-config.json")
    cfg.write_text(json.dumps({"export_file_path": str(export), "use_stdin": False, "num_threads": cpus,
                               "permitted_axioms": EXPECTED_AXIOMS, "unpermitted_axiom_hard_error": False,
                               "nat_extension": True, "string_extension": True}, indent=2) + "\n")
    return [exe, str(cfg)]


def checker_git_version(name: str, exe: str) -> str:
    """`nanoda <commit>` when the binary sits inside the clone it was built in (nanoda_bin has no --version)."""
    d, project = str(Path(exe).resolve().parent), {"nanoda": "nanoda_lib", "con-leche": "con-leche"}[name]
    try:
        url = subprocess.run(["git", "-C", d, "remote", "get-url", "origin"], capture_output=True, text=True, timeout=10)
        if url.returncode != 0 or project not in url.stdout:   # inside some other repo: its commit says nothing
            return ""
        r = subprocess.run(["git", "-C", d, "rev-parse", "--short=12", "HEAD"], capture_output=True, text=True, timeout=10)
        return f"{name} {r.stdout.strip()}" if r.returncode == 0 and r.stdout.strip() else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def find_checker(ctx: Ctx, name: str, given=None) -> str:
    if given:
        return given
    names = [name, "nanoda_bin"] if name == "nanoda" else [name]       # nanoda's cargo build makes `nanoda_bin`
    for n in names:
        if w := shutil.which(n):
            return w
        if (ctx.home / "tools/bin" / n).exists():
            return str(ctx.home / "tools/bin" / n)
    return str(ctx.home / "tools/bin" / name)


def keep_awake():
    """macOS: no idle sleep while this command runs (export and recheck take hours; only the build had this)."""
    if IS_MAC and shutil.which("caffeinate"):
        subprocess.Popen(["caffeinate", "-i", "-w", str(os.getpid())], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_recheck(ctx: Ctx, a):
    """Level 3 (optional): run an independent checker on the saved reference export."""
    keep_awake()
    name = "nanoda" if a.nanoda else "con-leche"
    need, ram = CHECKERS[name], total_ram_gb()
    if ram < need:
        raise Fail(f"{name} needs about {need} GB of memory; this computer has {ram:.0f} GB. "
                   "Level 3 is optional: a computer with more memory can run it.")
    rec = whole_build(ctx, a, "recheck")
    lv = levels_state(ctx, rec["olean_digest"])
    if (lv.get("export") or {}).get("sha256") != EXPORT_SHA256:
        raise Fail("recheck needs Level 2 first: run `riemann-at-home export` and reproduce the reference export")
    exe = find_checker(ctx, name, a.checker)
    if not Path(exe).exists():
        raise Fail(f"{name} is not installed. Build it from its project, then put it at "
                   f"{ctx.home / 'tools/bin' / name} or pass --checker PATH")
    version = a.checker_version
    if not version and name == "con-leche":                    # nanoda_bin has no --version (config file only)
        try:
            v = subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=30)
            version = (v.stdout or v.stderr).strip().splitlines()[0][:64] if v.returncode == 0 else ""
        except (OSError, subprocess.TimeoutExpired, IndexError):
            version = ""
    version = version or checker_git_version(name, exe) or "unknown"
    ctx.logs.mkdir(parents=True, exist_ok=True)
    export = saved_export(ctx, a)                              # the exporter has exited: its memory is free again
    log = ctx.logs / f"recheck-{name}.log"
    ccmd = checker_command(name, exe, export, shlex.split(a.checker_args or ""), os.cpu_count() or 1)
    print(f"re-checking the export with {name} {version} (needs about {need} GB of memory; takes hours)")
    print("  $ " + shlex.join(ccmd), file=sys.stderr)
    t0 = time.time()
    with open(log, "ab") as lf:
        try:
            crc = subprocess.run(ccmd, cwd=ctx.home, stdin=subprocess.DEVNULL, stdout=lf, stderr=subprocess.STDOUT).returncode
        except OSError as e:
            raise Fail(f"could not start {name} ({exe}): {e}. The saved export stays at {export}.")
    secs = int(time.time() - t0)
    if crc < 0:                                                # killed by a signal: no verdict, nothing recorded
        sig = -crc
        why = " (usually: the computer ran out of memory)" if sig == 9 else ""
        raise Fail(f"{name} was stopped by signal {sig}{why} after {secs / 3600:.1f} h, before it gave a verdict; "
                   f"nothing recorded. Log: {log}. The saved export stays at {export}, so a rerun skips the export.")
    if name == "con-leche" and crc not in (0, 1):             # arena convention: 1 rejected, 2 declined, 3 error
        what = "declined (it does not support something in the export)" if crc == 2 else "stopped with an error"
        raise Fail(f"con-leche {what}, exit {crc}, after {secs / 3600:.1f} h: no verdict on the proof, nothing recorded. "
                   f"Log: {log}. The saved export stays at {export}.")
    result = "accept" if crc == 0 else "reject"
    entry = {"name": name, "version": version, "result": result, "seconds": secs}
    lv = levels_state(ctx, rec["olean_digest"])
    lv["checkers"] = [e for e in lv.get("checkers", []) if e.get("name") != name] + [entry]
    ctx.set_conf(levels=lv)
    print(f"{name}: {result.upper()} in {secs / 3600:.1f} h (exit {crc}; log: {log})")
    out = write_record(ctx, make_record(ctx, a))
    print(f"{'Level 3. ' if result == 'accept' else ''}record with checkers: {out}")
    send_now(ctx, a, "recheck")
    other = "con-leche" if name == "nanoda" else "nanoda"
    print(f"the saved export stays at {export} ({EXPORT_BYTES / 1e9:,.1f} GB) so `recheck --{other}` can reuse it; "
          f"delete it when you are done: rm {shlex.quote(str(export))}")
    return 0 if result == "accept" else 1


README = Path(__file__).resolve().parent / "README.md"       # shipped next to this script


def statement_text() -> str:
    """The joint statement, word for word from the README's "## Joint statement" section."""
    m = re.search(r"^## Joint statement[ \t]*\n(.*?)(?=^## |\Z)", read(README), re.M | re.S)
    text = " ".join(m[1].split()) if m else ""
    if not text.startswith("Riemann@home: a joint statement"):
        raise Fail(f"the joint statement is missing from {README} (it ships next to this tool)")
    return text


def cmd_sign(ctx: Ctx, a):
    """Sign the joint statement: allowed at Level 2 or 3. Shows the text and asks first.
    --when-done: sign in advance, taking effect only when the export matches. --cancel: take back either."""
    if getattr(a, "cancel", False):
        ctx.set_conf(sign_when_done=None)
        lvc = ctx.conf().get("levels")
        if lvc and lvc.get("sign_statement"):
            lvc["sign_statement"] = False
            ctx.set_conf(levels=lvc)
            write_record(ctx, make_record(ctx, a))
            print("signature withdrawn: new records no longer carry it")
            send_now(ctx, a, "signature withdrawn")
        else:
            print("not signed in advance any more")
        return 0
    if getattr(a, "when_done", False):
        import textwrap
        print("\n" + textwrap.fill(statement_text(), 100) + "\n")
        if sys.stdin.isatty():
            try:
                if input("Sign it when your export matches? [y/N] ").strip().lower() not in ("y", "yes"):
                    print("not signed in advance")
                    return 1
            except EOFError:
                print("not signed in advance")
                return 1
        set_sign_when_done(ctx)
        return 0
    rec = whole_build(ctx, a, "signing")
    if record_level(rec) < 2:
        raise Fail("signing needs Level 2: a whole build whose export reproduces the reference "
                   "(run `riemann-at-home export`)")
    import textwrap
    print("\n" + textwrap.fill(statement_text(), 100) + "\n")
    print(f"You are at Level {record_level(rec)}. Your signature is your own report, tied to your GitHub account.")
    try:
        yes = input("Sign this statement? [y/N] ").strip().lower() in ("y", "yes")
    except EOFError:
        yes = False
    if not yes:
        print("not signed")
        return 1
    lv = levels_state(ctx, rec["olean_digest"])
    lv["sign_statement"] = True
    ctx.set_conf(levels=lv)
    out = write_record(ctx, make_record(ctx, a))
    print(f"signed: records now carry \"sign_statement\": true\n{out}")
    send_now(ctx, a, "signed")
    share_nudge(ctx, "signed")
    return 0


