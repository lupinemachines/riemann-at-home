def fixed_folder(proof: str = DEFAULT_PROOF) -> Path:
    f = PROOFS[proof]["folders"].get(platform.system())
    if not f:
        raise Fail(f"no fixed build folder defined for {platform.system()} yet (macOS and Linux only)")
    return Path(f)


class Ctx:
    def __init__(self, a, proof: str = None):
        self.base = Path(os.environ.get("RAH_HOME") or Path.home() / ".riemann-at-home")   # the person's files
        pk = proof or getattr(a, "proof", None)
        if pk not in PROOFS and getattr(a, "folder", None):
            pk = proof_of_folder(Path(a.folder))      # e.g. a supervisor started by an older version (no --proof)
        self.proof = pk if pk in PROOFS else chosen_proof(self.base)
        self.p = PROOFS[self.proof]
        self.home = self.base / self.p["state"] if self.p["state"] else self.base           # this proof's build
        self.base_config = self.base / "config.json"
        self.folder = Path(a.folder) if getattr(a, "folder", None) else fixed_folder(self.proof)
        self.logs = Path(a.logs) if getattr(a, "logs", None) else self.home / "logs"
        self.records = self.home / "records"
        self.status = self.logs / "status.txt"
        self.samples = self.logs / "samples.txt"
        self.mode_file = self.logs / "mode.txt"
        self.pid_file = self.logs / "build.pid"      # supervisor (this script, `_run`)
        self.pgid_file = self.logs / "build.pgid"    # process group of time/nice/lake/lean
        self.caff_file = self.logs / "caffeinate.pid"
        self.build_id_file = self.home / "build_id"
        self.config = self.home / "config.json"

    def build_id(self, create=True) -> str:
        """Random per-computer id (16 hex chars), made once by setup and kept."""
        b = read(self.build_id_file).strip()
        if re.fullmatch(r"[0-9a-f]{16}", b) or not create:
            return b or None
        b = secrets.token_hex(8)
        self.home.mkdir(parents=True, exist_ok=True)
        self.build_id_file.write_text(b + "\n")
        return b

    @staticmethod
    def _load(p: Path) -> dict:
        try:
            d = json.loads(p.read_text())
            return d if isinstance(d, dict) else {}
        except (OSError, ValueError):
            return {}

    def conf(self) -> dict:
        """This build's config.json, plus the person's shared choices (SHARED_KEYS) from the top config.json."""
        own = self._load(self.config)
        if self.config == self.base_config:
            return own
        shared = self._load(self.base_config)
        return {**{k: v for k, v in own.items() if k not in SHARED_KEYS},
                **{k: shared[k] for k in SHARED_KEYS if k in shared}}

    def set_conf(self, **kw):
        def write(p: Path, upd: dict):
            if upd:
                p.parent.mkdir(parents=True, exist_ok=True)
                p.write_text(json.dumps({**self._load(p), **upd}, indent=1) + "\n")
        if self.config == self.base_config:
            return write(self.config, kw)
        write(self.base_config, {k: v for k, v in kw.items() if k in SHARED_KEYS})
        write(self.config, {k: v for k, v in kw.items() if k not in SHARED_KEYS})

    def me(self) -> list:
        """This script, for a background command about this same proof (with RAH_HOME = self.env())."""
        return [sys.executable, "-I", str(Path(__file__).resolve())]

    def pargs(self) -> list:
        """--proof for a command started from this one, so it works on the same proof whatever setup chose."""
        return ["--proof", self.proof]

    def env(self) -> dict:
        return {**os.environ, "RAH_HOME": str(self.base)}

    @property
    def lib(self) -> Path:
        return self.folder / ".lake/build/lib/lean"


def now_utc() -> datetime:
    return datetime.now(timezone.utc)


def iso(t: float) -> str:
    return datetime.fromtimestamp(t, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_time(s: str):
    """ISO `2026-11-21T15:26:31Z`, or an older build-script form `2026-11-21 07:26:31 PST` (local time)."""
    s = s.strip()
    try:
        return datetime.strptime(s[:20], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
    except ValueError:
        pass
    m = re.match(r"(\d{4}-\d\d-\d\d) (\d\d:\d\d:\d\d)", s)
    if m:
        return time.mktime(time.strptime(f"{m[1]} {m[2]}", "%Y-%m-%d %H:%M:%S"))
    return None


