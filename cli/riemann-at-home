# ---------------------------------------------------------------- module list, bitmap, digest

def all_modules(folder: Path) -> list:
    """All src/**/*.lean as dotted names, sorted byte-wise (UTF-8 byte order == code point order)."""
    src = folder / "src"
    out = []
    for root, dirs, files in os.walk(src):
        rel = os.path.relpath(root, src)
        for f in files:
            if f.endswith(".lean"):
                out.append((f[:-5] if rel == "." else f"{rel}/{f[:-5]}").replace(os.sep, ".").replace("/", "."))
    return sorted(out, key=lambda m: m.encode())


def compiled_modules(lib: Path) -> set:
    """Modules Lake has finished: both `.olean` and `.trace` present. Lake writes the trace last, so an
    .olean without one (a build stopped mid-module) is not finished and Lake rebuilds it."""
    out = set()
    for root, _, files in os.walk(lib):
        rel = os.path.relpath(root, lib)
        fs = set(files)
        for f in files:
            if f.endswith(".olean") and f[:-6] + ".trace" in fs:
                out.add((f[:-6] if rel == "." else f"{rel}/{f[:-6]}").replace(os.sep, "."))
    return out


def count_compiled(lib: Path) -> int:
    return len(compiled_modules(lib))


def encode_bitmap(bits: list) -> str:
    """bit i = module i compiled, LSB-first within each byte, gzip (mtime 0) then base64."""
    b = bytearray((len(bits) + 7) // 8)
    for i, on in enumerate(bits):
        if on:
            b[i >> 3] |= 1 << (i & 7)
    return base64.b64encode(gzip.compress(bytes(b), compresslevel=9, mtime=0)).decode()


def decode_bitmap(b64: str, n: int) -> list:
    b = gzip.decompress(base64.b64decode(b64))
    if len(b) != (n + 7) // 8:
        raise ValueError(f"bitmap is {len(b)} bytes, expected {(n + 7) // 8}")
    return [bool(b[i >> 3] >> (i & 7) & 1) for i in range(n)]


class HashCache:
    """sha256 of each .olean, keyed by (path, size, mtime), so repeat records only hash new files."""
    def __init__(self, path: Path):
        self.path, self.d = path, {}
        try:
            self.d = json.loads(path.read_text())
        except (OSError, ValueError):
            pass

    def get(self, p: Path) -> bytes:
        st = p.stat()
        key = str(p)
        e = self.d.get(key)
        if e and e[0] == st.st_size and e[1] == st.st_mtime_ns:
            return bytes.fromhex(e[2])
        h = sha256_file(p)
        self.d[key] = [st.st_size, st.st_mtime_ns, h]
        return bytes.fromhex(h)

    def save(self):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        tmp = self.path.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.d))
        tmp.replace(self.path)


def olean_digest(lib: Path, mods: list, bits: list, cache: HashCache = None) -> str:
    """sha256 over sha256(.olean bytes) (32 raw bytes each) of each compiled module, in index order."""
    h = hashlib.sha256()
    for m, on in zip(mods, bits):
        if on:
            p = lib / (m.replace(".", "/") + ".olean")
            h.update(cache.get(p) if cache else bytes.fromhex(sha256_file(p)))
    return h.hexdigest()


