def proof_of_folder(folder: Path):
    """Which proof a build folder holds: one of the fixed folders, else the one its lean-toolchain pins; or None."""
    for pk, P in PROOFS.items():
        if str(folder) in P["folders"].values():
            return pk
    try:
        tc = (folder / "lean-toolchain").read_text().strip()
    except OSError:
        return None
    hits = [pk for pk, P in PROOFS.items() if P["toolchain"] == tc]
    return hits[0] if len(hits) == 1 else None


def chosen_proof(base: Path) -> str:
    """The proof a command means when it does not say: the one setup chose for this computer (the first not yet
    finished, for "both"), else 17M, so a computer set up before the 300K proof keeps working exactly as before."""
    try:
        ch = json.loads((base / "config.json").read_text()).get("proofs") or {}
    except (OSError, ValueError):
        ch = {}
    act = ch.get("active") if isinstance(ch, dict) else None
    return act if act in PROOFS else DEFAULT_PROOF


