def machine() -> dict:
    cpu = ""
    if IS_MAC:
        cpu = subprocess.run(["sysctl", "-n", "machdep.cpu.brand_string"], capture_output=True, text=True).stdout.strip()
    else:
        m = re.search(r"^model name\s*:\s*(.+)$", read(Path("/proc/cpuinfo")), re.M)
        cpu = m[1].strip() if m else ""
    cpu = cpu or platform.processor() or ""
    label = os.environ.get("RAH_CPU_LABEL", "").strip()   # this fork: name the platform in front of the chip
    return {"os": f"{platform.system()} {platform.release()}", "arch": platform.machine(),
            "cpu": (f"{label} ({cpu})" if cpu else label) if label else cpu, "cores": int(os.cpu_count() or 0)}


def events(ctx: Ctx) -> list:
    out = []
    for line in read(ctx.status).splitlines():
        kind, _, rest = line.partition(" ")
        t = parse_time(rest)
        if t is not None:
            out.append((kind.split("=")[0], kind, t))
    return out


def samples(ctx: Ctx) -> list:
    """(time, modules compiled) from samples.txt; either timestamp form."""
    out = []
    for line in read(ctx.samples).splitlines():
        m = re.match(r"(\S+(?: \d\d:\d\d:\d\d)?)\s+(?:oleans|modules)=(\d+)", line)
        if m:
            t = parse_time(m[1])
            if t is not None:
                out.append((t, int(m[2])))
    return out


def busy_seconds(ctx: Ctx, running: bool, now: float = None) -> tuple:
    """(started, busy seconds): wall time the build was running, summed over sessions, minus pauses.
    A session opens at START/RESTART and closes at BUILD_EXIT. A session with no BUILD_EXIT (the build was
    killed) closes at its last sign of life: the last sample, or the build log's last write."""
    now = now or time.time()
    ev = events(ctx)
    smp = [t for t, _ in samples(ctx)]
    started = next((t for k, _, t in ev if k == "START"), None) or next((t for k, _, t in ev if k == "RESTART"), None)
    total, open_at, paused_at, paused = 0.0, None, None, 0.0

    def last_alive(after, before):
        cands = [t for t in smp if after <= t <= before]
        for p in (ctx.logs / "build.log", ctx.logs / "time.txt"):
            try:
                mt = p.stat().st_mtime
                if after <= mt <= before:
                    cands.append(mt)
            except OSError:
                pass
        return max(cands) if cands else after

    def close(end):
        nonlocal total, open_at, paused_at, paused
        if paused_at is not None:
            paused += max(0.0, end - paused_at)
        total += max(0.0, end - open_at - paused)
        open_at, paused_at, paused = None, None, 0.0

    for i, (k, _, t) in enumerate(ev):
        if k in ("START", "RESTART"):
            if open_at is not None:
                close(last_alive(open_at, t))
            open_at = t
        elif open_at is None:
            continue
        elif k == "PAUSE" and paused_at is None:
            paused_at = t
        elif k == "RESUME" and paused_at is not None:
            paused += t - paused_at
            paused_at = None
        elif k == "BUILD_EXIT":
            close(t)
    if open_at is not None:
        close(now if running else last_alive(open_at, now))
    return started, int(round(total))


def parse_axioms(text: str, theorem: str = "riemannHypothesis"):
    """The axioms Lean prints for `theorem`, or None if the check did not print them."""
    m = re.search(rf"'{re.escape(theorem)}' depends on axioms:\s*\[([^\]]*)\]", text)
    if m:
        return [a.strip() for a in m[1].split(",") if a.strip()]
    if re.search(rf"'{re.escape(theorem)}' does not depend on any axioms", text):
        return []
    return None


def proof_axioms(ctx, text: str):
    """The axioms a record carries: those of every theorem the proof counts, together (first seen first), or None
    if the check did not print them all. 17M: riemannHypothesis. 300K: its five theorems."""
    out = []
    for t in ctx.p["theorems"]:
        ax = parse_axioms(text, t)
        if ax is None:
            return None
        out += [x for x in ax if x not in out]
    return out


# ---------------------------------------------------------------- processes

def ps_table() -> list:
    out = subprocess.run(["ps", "-axo", "pid=,pgid=,stat=,comm="], capture_output=True, text=True).stdout
    rows = []
    for line in out.splitlines():
        parts = line.split(None, 3)
        if len(parts) == 4:
            rows.append((int(parts[0]), int(parts[1]), parts[2], os.path.basename(parts[3])))
    return rows


def pid_alive(pid: int, must_contain: str = None) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    if must_contain:
        cmd = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], capture_output=True, text=True).stdout
        return must_contain in cmd
    return True


def read_pid(p: Path):
    try:
        return int(p.read_text().strip())
    except (OSError, ValueError):
        return None


def supervisor(ctx: Ctx):
    pid = read_pid(ctx.pid_file)
    return pid if pid and pid_alive(pid, " _run") else None


def outside_build(ctx: Ctx) -> list:
    """lake processes working in this folder that this tool did not start (e.g. an older build script).
    Two builds in one folder would fight over the same files, so `build` refuses while one runs."""
    pgid = read_pid(ctx.pgid_file)
    ours = {p for p, g, _, _ in ps_table() if pgid and g == pgid}
    found = []
    for pid, _, _, comm in ps_table():
        if comm != "lake" or pid in ours:
            continue
        r = subprocess.run(["lsof", "-a", "-d", "cwd", "-p", str(pid), "-Fn"], capture_output=True, text=True)
        cwd = next((l[1:] for l in r.stdout.splitlines() if l.startswith("n")), None)
        if cwd is None and Path(f"/proc/{pid}/cwd").exists():
            try:
                cwd = os.readlink(f"/proc/{pid}/cwd")
            except OSError:
                pass
        if cwd and os.path.realpath(cwd) == os.path.realpath(ctx.folder):
            found.append(pid)
    return found


def group_procs(pgid: int) -> list:
    return [r for r in ps_table() if r[1] == pgid]


def is_paused(ctx: Ctx) -> bool:
    ev = [k for k, _, _ in events(ctx) if k in ("PAUSE", "RESUME", "START", "RESTART", "BUILD_EXIT")]
    return bool(ev) and ev[-1] == "PAUSE"


def set_priority(pids: list, mode: str):
    """gentle = background policy (macOS taskpolicy -b / Linux SCHED_IDLE); full = normal (still nice 19)."""
    for pid in pids:
        if IS_MAC:
            subprocess.run(["taskpolicy", "-b" if mode == "gentle" else "-B", "-p", str(pid)], capture_output=True)
        elif hasattr(os, "sched_setscheduler"):
            try:
                pol = os.SCHED_IDLE if mode == "gentle" else os.SCHED_OTHER
                os.sched_setscheduler(pid, pol, os.sched_param(0))
            except OSError:
                pass


def build_pids(ctx: Ctx, names=("lake", "lean")) -> list:
    pgid = read_pid(ctx.pgid_file)
    return [p for p, _, _, c in group_procs(pgid) if c in names] if pgid else []


def start_caffeinate(ctx: Ctx, pgid: int):
    """Keep the Mac from idle-sleeping while the build runs (released while paused)."""
    if IS_MAC and shutil.which("caffeinate"):
        c = subprocess.Popen(["caffeinate", "-i", "-w", str(pgid)], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        ctx.caff_file.write_text(str(c.pid))


def stop_caffeinate(ctx: Ctx):
    pid = read_pid(ctx.caff_file)
    if pid and pid_alive(pid, "caffeinate"):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    ctx.caff_file.unlink(missing_ok=True)


# ---------------------------------------------------------------- setup

def toolchain_of(folder: Path) -> str:
    return read(folder / "lean-toolchain").strip()


def mathlib_rev_of(folder: Path):
    try:
        pk = json.loads((folder / "lake-manifest.json").read_text())["packages"]
        return next((p.get("rev") for p in pk if p.get("name") == "mathlib"), None)
    except (OSError, ValueError, KeyError):
        return None


def download_archive(ctx: Ctx, url_template: str) -> Path:
    dl = ctx.home / "download"
    dl.mkdir(parents=True, exist_ok=True)
    out = dl / "lean.tar.gz"
    if out.exists() and out.stat().st_size == ARCHIVE_BYTES and sha256_file(out) == ARCHIVE_SHA256:
        print(f"archive already downloaded and verified: {out}")
        return out
    for i in range(1, PARTS + 1):
        nn = f"{i:02d}"
        part = dl / f"lean.tar.gz.part{nn}"
        url = url_template.format(nn=nn)
        req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
        with urllib.request.urlopen(req, timeout=120) as r:
            size = r.headers.get("Content-Length")
            if part.exists() and size and part.stat().st_size == int(size):
                print(f"  part {nn}/{PARTS} already here")
                continue
            print(f"  part {nn}/{PARTS} <- {url}")
            tmp = part.with_suffix(".tmp")
            with open(tmp, "wb") as f:
                shutil.copyfileobj(r, f, 1 << 20)
            tmp.replace(part)
    h = hashlib.sha256()
    tmp = out.with_suffix(".tmp")
    with open(tmp, "wb") as f:
        for i in range(1, PARTS + 1):
            with open(dl / f"lean.tar.gz.part{i:02d}", "rb") as p:
                for chunk in iter(lambda: p.read(1 << 20), b""):
                    h.update(chunk)
                    f.write(chunk)
    if h.hexdigest() != ARCHIVE_SHA256:
        tmp.unlink()
        raise Fail(f"downloaded archive has sha256 {h.hexdigest()}, expected {ARCHIVE_SHA256}; parts kept in {dl} "
                   "(delete them to download again)")
    tmp.replace(out)
    for i in range(1, PARTS + 1):
        (dl / f"lean.tar.gz.part{i:02d}").unlink(missing_ok=True)
    return out


def unpack(archive: Path, folder: Path):
    parent = folder.parent
    try:
        parent.mkdir(parents=True, exist_ok=True)
    except PermissionError:
        raise Fail(f"cannot create {parent}. Run once:  sudo mkdir -p {parent} && sudo chown $USER {parent}")
    staging = parent / f".unpacking-{os.getpid()}"
    shutil.rmtree(staging, ignore_errors=True)
    staging.mkdir()
    try:
        with tarfile.open(archive, "r:gz") as t:
            members = t.getmembers()
            bad = [m.name for m in members if not (m.name == "lean" or m.name.startswith("lean/"))
                   or ".." in m.name.split("/") or not (m.isfile() or m.isdir())]
            if bad:
                raise Fail(f"archive has unexpected entries, refusing to unpack: {bad[:3]}")
            kw = {"filter": "data"} if hasattr(tarfile, "data_filter") else {}
            t.extractall(staging, members=members, **kw)
        (staging / "lean").rename(folder)
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def ensure_elan():
    elan = which("elan")
    if elan:
        return elan
    print("installing elan (the Lean version manager) from github.com/leanprover/elan")
    init = Path(os.environ.get("TMPDIR", "/tmp")) / f"elan-init-{os.getpid()}.sh"
    req = urllib.request.Request("https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh",
                                 headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=120) as r:
        init.write_bytes(r.read())
    try:
        if run(["sh", str(init), "-y", "--default-toolchain", "none"]).returncode != 0:
            raise Fail("elan install failed")
    finally:
        init.unlink(missing_ok=True)
    elan = which("elan")
    if not elan:
        raise Fail("elan installed but not found in ~/.elan/bin")
    return elan


def toolchain_installed(elan: str, toolchain: str = TOOLCHAIN) -> bool:
    out = subprocess.run([elan, "toolchain", "list"], capture_output=True, text=True, env=lean_env()).stdout
    return any(l.split()[0] == toolchain for l in out.splitlines() if l.strip())


def mathlib_cache_present(folder: Path) -> bool:
    return (folder / ".lake/packages/mathlib/.lake/build/lib/lean/Mathlib.olean").exists()


def others_text(data: dict, my_cpu: str = "") -> str:
    """How long the build and the export took on other volunteers' computers, from the leaderboard's data.json:
    one line per finished build, fastest first, so a newcomer can see where a computer like theirs lands. The
    original proof (17M) first, then each other proof (from each row's `proofs`)."""
    def h(x):
        return f"{x:.0f} h" if x >= 10 else f"{x:.1f} h"
    mine = " ".join(my_cpu.split()).lower()
    def like(cpu):
        return "  <- like this computer" if mine and cpu.lower() == mine else ""
    out = []
    rows = [r for r in data.get("leaderboard") or [] if r.get("whole_proof") and r.get("build_hours")]
    if rows:
        rows.sort(key=lambda r: r["build_hours"])
        hours = [r["build_hours"] for r in rows]
        exports = [r for r in rows if (r.get("export") or {}).get("done") and (r.get("export") or {}).get("matches")]
        out += [f"How long it took others ({len(rows)} whole builds so far, from the leaderboard):",
                f"  build:  {h(hours[0])} to {h(hours[-1])}; half finished within {h(hours[(len(hours) - 1) // 2])}"]
        if exports:
            ex = sorted(r["export"]["seconds"] / 3600 for r in exports)
            out.append(f"  export: {h(ex[0])} to {h(ex[-1])} ({len(ex)} finished); it is slowest on computers with "
                       "less than about 140 GB of memory")
        out.append(f"  {'computer':<44} {'build':>6}  {'export':>6}")
        for r in rows:
            e = r.get("export") or {}
            ex = h(e["seconds"] / 3600) if e.get("done") and e.get("matches") else "-"
            cpu = " ".join(str(r.get("machine") or "?").split())
            out.append(f"  {cpu[:44]:<44} {h(r['build_hours']):>6}  {ex:>6}{like(cpu)}")
    for pk, P in PROOFS.items():
        if pk == DEFAULT_PROOF:
            continue
        got = [((r.get("proofs") or {}).get(pk) or {}) for r in data.get("leaderboard") or []]
        got = sorted((g for g in got if g.get("whole") and g.get("build_hours")), key=lambda g: g["build_hours"])
        if not got:
            continue
        hours = [g["build_hours"] for g in got]
        if out:
            out.append("")
        out += [f"The {P['label']} proof ({P['name']}): {len(got)} whole build{'s' if len(got) != 1 else ''} so far, "
                f"{h(hours[0])} to {h(hours[-1])}; half finished within {h(hours[(len(hours) - 1) // 2])}",
                f"  {'computer':<44} {'build':>6}"]
        for g in got:
            cpu = " ".join(str(g.get("machine") or "?").split())
            out.append(f"  {cpu[:44]:<44} {h(g['build_hours']):>6}{like(cpu)}")
    return "\n".join(out)


def fetch_board():
    """The live leaderboard's data.json, or None (optional: any failure, or RAH_NO_STATS, gives None)."""
    if os.environ.get("RAH_NO_STATS"):
        return None
    try:
        req = urllib.request.Request(SITE_URL + "data.json", headers={"User-Agent": USER_AGENT})
        with urllib.request.urlopen(req, timeout=10) as r:
            return json.loads(r.read(5_000_000))
    except Exception:
        return None


def show_others(ctx, data=None):
    """Print others_text from the live leaderboard. Optional: any failure prints nothing."""
    try:
        data = data if data is not None else fetch_board()
        text = others_text(data, machine().get("cpu", "")) if data else ""
    except Exception:
        return
    if text:
        print(text + "\n")


# The question setup asks (owner's wording, 2026-11-25). 1 = the default, and what a run without a terminal gets.
SETUP_QUESTION = """Which proof do you want to build?
Both are Lean proofs of the Riemann Hypothesis using the same three axioms. Both put you on the leaderboard.

  1) The new proof  [300K]  recommended
     About 300,000 lines. 20 min to 2 h on most computers, 24 GB of memory.
     The quickest way onto the leaderboard.
  2) The original proof  [17M]  the big challenge
     175,187 modules. Builds took 9 h to 64 h; the export wants about 140 GB of memory.
     Counts most on the leaderboard.
  3) Both  [17M] [300K]  ranks highest
     The new proof first, then the original.
"""
SETUP_ANSWERS = {"1": ["300k"], "2": ["17m"], "3": ["300k", "17m"]}


def legacy_17m(ctx) -> bool:
    """Set up for 17M before setup asked which proof: keep it that way."""
    return (ctx.base / "build_id").exists()        # every earlier setup made one (and only 17M existed)


def ask_proof(ctx, data=None) -> list:
    """Setup's question. In a terminal: 1, 2 or 3 (Enter = 1). Without one (an AI assistant, a script): 1."""
    ctx._asked = True
    print(SETUP_QUESTION)
    show_others(ctx, data)
    if not sys.stdin.isatty():
        print("Not asked (no terminal): setting up the new proof (300K). For the original instead: "
              "riemann-at-home setup --proof 17m; for both: riemann-at-home setup --proof both\n"
              "(If an AI assistant is running this: tell the person these three choices and let them pick.)\n")
        return SETUP_ANSWERS["1"]
    while True:
        try:
            ans = input("Choose [1]: ").strip() or "1"
        except EOFError:
            ans = "1"
        if ans in SETUP_ANSWERS:
            return SETUP_ANSWERS[ans]
        print("Please type 1, 2 or 3.")


def setup_choice(ctx, a) -> list:
    """Which proofs this setup sets up, in build order."""
    want = getattr(a, "proof", None)
    if want == "both":
        return ["300k", "17m"]
    if want in PROOFS:
        return [want]
    if getattr(a, "archive", None) or getattr(a, "parts_url", PART_URL) != PART_URL:
        return [DEFAULT_PROOF]                        # given the 17M archive or its parts: that's the 17M proof
    ch = ctx.conf().get("proofs") or {}
    if ch.get("active") in PROOFS:                    # running setup again: the same proofs as last time
        return [ch["active"]] + [x for x in ch.get("next") or [] if x in PROOFS]
    if legacy_17m(ctx):
        print("This computer is set up for the original proof (17M), so setup carries on with it. To build the new "
              "proof (300K) too: riemann-at-home setup --proof 300k\n")
        return [DEFAULT_PROOF]
    return ask_proof(ctx, fetch_board())


def cmd_setup(ctx: Ctx, a):
    order = setup_choice(ctx, a)
    ch = ctx.conf().get("proofs") or {}
    active = ch.get("active") if ch.get("active") in PROOFS else (DEFAULT_PROOF if legacy_17m(ctx) else None)
    for k, pk in enumerate(order):
        c = Ctx(a, proof=pk)
        if getattr(a, "folder", None) and len(order) > 1:
            c.folder = Path(a.folder) / PROOFS[pk]["folders"]["Linux"].rsplit("/", 1)[-1]   # testing: lean/, grh/
        if order != [DEFAULT_PROOF]:                  # 17M alone: setup reads exactly as before
            print(f"== {PROOFS[pk]['label']}: {PROOFS[pk]['name']}" + (f" ({k + 1} of {len(order)})" if len(order) > 1 else ""))
        disk_heads_up(c)
        if pk == DEFAULT_PROOF and len(order) == 1 and not getattr(ctx, "_asked", False):
            show_others(c)
        (setup_17m if pk == DEFAULT_PROOF else setup_git)(c, a)
        print(f"this computer's build_id: {c.build_id()}" if order == [DEFAULT_PROOF]
              else f"this computer's {PROOFS[pk]['label']} build_id: {c.build_id()}\n")
    if active and active not in order:                # another proof is already set up here: it stays the default
        print(f"Commands without --proof still mean {PROOFS[active]['label']} here; for this one add "
              f"--proof {order[0]} (for example: riemann-at-home build --proof {order[0]}).")
        ctx.set_conf(proofs={**ch, "active": active})
        nxt = f"riemann-at-home build --proof {order[0]}"
    else:
        ctx.set_conf(proofs={"active": order[0], "next": order[1:]})
        nxt = "riemann-at-home build"
    ask_consent(Ctx(a, proof=order[0]))
    print(f"ready. Next: {nxt}" + (f"   (when the {PROOFS[order[0]]['label']} build is done, the "
                                   f"{PROOFS[order[1]]['label']} build starts by itself)" if len(order) > 1 else ""))


def setup_17m(ctx: Ctx, a):
    """The original proof: the official archive from alpo.ge, checked and unpacked; Lean 4.33.1; Mathlib cache."""
    folder = ctx.folder
    if folder.exists():
        tc = toolchain_of(folder)
        if tc != TOOLCHAIN:
            raise Fail(f"{folder} exists but pins {tc or 'no toolchain'}, expected {TOOLCHAIN}. "
                       "Move it aside and run setup again.")
        if mathlib_rev_of(folder) != MATHLIB_REV:
            raise Fail(f"{folder} pins Mathlib {mathlib_rev_of(folder)}, expected {MATHLIB_REV}")
        print(f"[1/3] proof folder already here with {TOOLCHAIN}: {folder} (skipping download)")
    else:
        if a.archive:
            archive = Path(a.archive).expanduser()
            print(f"[1/3] checking {archive}")
            if sha256_file(archive) != ARCHIVE_SHA256:
                raise Fail(f"{archive} does not have sha256 {ARCHIVE_SHA256}")
        else:
            print(f"[1/3] downloading the official archive ({PARTS} parts, {ARCHIVE_BYTES / 1e6:.0f} MB)")
            archive = download_archive(ctx, a.parts_url)
        print(f"      sha256 {ARCHIVE_SHA256} ok; unpacking into {folder}")
        unpack(archive, folder)
        if toolchain_of(folder) != TOOLCHAIN:
            raise Fail(f"unpacked archive pins {toolchain_of(folder)}, expected {TOOLCHAIN}")
    install_lean(ctx, a, "Mathlib")


def install_lean(ctx: Ctx, a, cache_target):
    """Steps 2 and 3 of every proof's setup: its pinned Lean through elan, then Mathlib's compiled cache."""
    tc, folder = ctx.p["toolchain"], ctx.folder
    elan = ensure_elan()
    if toolchain_installed(elan, tc):
        print(f"[2/3] Lean {tc} already installed")
    else:
        print(f"[2/3] installing Lean {tc}")
        if run([elan, "toolchain", "install", tc], env=lean_env()).returncode != 0:
            raise Fail("toolchain install failed")
    cmd = [which("lake") or "lake", "exe", "cache", "get"] + ([cache_target] if cache_target else [])
    shown = " ".join(["lake"] + cmd[1:])
    if mathlib_cache_present(folder) and not a.force_cache:
        print("[3/3] Mathlib compiled cache already here")
    elif a.skip_cache:
        print("[3/3] skipping Mathlib cache (--skip-cache)")
    else:
        print(f"[3/3] fetching Mathlib's compiled cache ({shown})")
        if run(cmd, cwd=folder, env=lean_env()).returncode != 0:
            raise Fail(f"`{shown}` failed; run setup again to retry")


SOURCE_FILE = ".riemann-at-home-source.json"   # in a git-sourced build folder: the commit and tree it came from


def source_problem(folder: Path, P: dict):
    """Why `folder` is not the proof's pinned source (None if it is): the commit and tree setup checked, recorded in
    SOURCE_FILE, plus the pinned toolchain and Mathlib."""
    try:
        src = json.loads((folder / SOURCE_FILE).read_text())
    except (OSError, ValueError):
        return f"{folder} was not set up by riemann-at-home (no {SOURCE_FILE}); move it aside and run setup again"
    if src.get("commit") != P["source"] or src.get("tree") != P["tree"]:
        return f"{folder} is from commit {src.get('commit')}, expected {P['source']}; move it aside and run setup again"
    if toolchain_of(folder) != P["toolchain"]:
        return f"{folder} pins {toolchain_of(folder) or 'no toolchain'}, expected {P['toolchain']}"
    if mathlib_rev_of(folder) != P["mathlib_rev"]:
        return f"{folder} pins Mathlib {mathlib_rev_of(folder)}, expected {P['mathlib_rev']}"
    return None


def setup_git(ctx: Ctx, a):
    """A proof published as a git repository (300K): clone it, check out exactly the pinned commit, check HEAD and
    the edition's tree, and move that folder (grh/) into the fixed build folder. Then its Lean and Mathlib cache."""
    P, folder = ctx.p, ctx.folder
    if folder.exists():
        err = source_problem(folder, P)
        if err:
            raise Fail(err)
        print(f"[1/3] proof folder already here at commit {P['source'][:12]}: {folder} (skipping the clone)")
    else:
        if not shutil.which("git"):
            raise Fail("git is needed to get this proof (macOS: xcode-select --install; Linux: your package manager)")
        url = getattr(a, "source_url", None) or P["repo"]
        parent = folder.parent
        try:
            parent.mkdir(parents=True, exist_ok=True)
        except PermissionError:
            raise Fail(f"cannot create {parent}. Run once:  sudo mkdir -p {parent} && sudo chown $USER {parent}")
        staging = parent / f".cloning-{os.getpid()}"
        shutil.rmtree(staging, ignore_errors=True)
        print(f"[1/3] cloning {url} at commit {P['source']}")
        try:
            if run(["git", "clone", "-q", "--no-checkout", url, staging]).returncode != 0:
                raise Fail(f"git clone {url} failed; run setup again to retry")
            g = lambda *x: subprocess.run(["git", "-C", str(staging), *x], capture_output=True, text=True)
            if g("-c", "advice.detachedHead=false", "checkout", "-q", "--detach", P["source"]).returncode != 0:
                raise Fail(f"{url} has no commit {P['source']}")
            head, tree = g("rev-parse", "HEAD").stdout.strip(), g("rev-parse", f"HEAD:{P['subdir']}").stdout.strip()
            if head != P["source"] or tree != P["tree"] or g("status", "--porcelain").stdout.strip():
                raise Fail(f"the checkout is not the pinned source (HEAD {head}, {P['subdir']}/ tree {tree}; "
                           f"expected {P['source']}, {P['tree']})")
            print(f"      HEAD {head} ok, {P['subdir']}/ tree {tree} ok; moving it to {folder}")
            (staging / P["subdir"]).rename(folder)
            (folder / SOURCE_FILE).write_text(json.dumps({"repo": url, "commit": head, "tree": tree}) + "\n")
        finally:
            shutil.rmtree(staging, ignore_errors=True)
        err = source_problem(folder, P)
        if err:
            raise Fail(err)
    install_lean(ctx, a, None)


