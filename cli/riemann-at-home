def ask_sign_when_done(ctx: Ctx):
    """Setup, after the posting yes (owner, 2026-11-23): sign the joint statement now, to take effect only if this
    build finishes and its export matches the reference. In a terminal: y/N. Otherwise print how to agree."""
    if sign_when_done(ctx):
        return
    import textwrap
    print("\nOne more, optional. If your whole build finishes and your export matches the reference, do you want to "
          "sign the joint statement?\n\n" + textwrap.fill(statement_text(), 100) + "\n")
    if not sys.stdin.isatty():
        print("To sign it in advance: riemann-at-home sign --when-done   (it takes effect only if your export matches)\n"
              "(If an AI assistant is running this: show the person this statement word for word and wait for their "
              "answer.)")
